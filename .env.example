# Copy this file to .env.local and fill in your values
# .env.local is gitignored and should NEVER be committed

# YouTube Data API v3
# Used to auto-fetch YouTube channel avatars for friends
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# GitHub personal access token (no scopes needed - public data only)
# Without this, GitHub API routes fall back to unauthenticated requests,
# capped at 60 req/hr shared across every visitor to the site.
# Get one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Shared secret required to call POST /api/cron/revalidate.
# Generate one with: openssl rand -hex 32
# Point your scheduler (cron, GitHub Actions, etc.) at that endpoint with
# header: Authorization: Bearer <this value>
CRON_SECRET=

